Name:           @CPACK_PACKAGE_NAME@
Version:        @CPACK_PACKAGE_VERSION@
Release:        1%{?dist}
Summary:        @CPACK_PACKAGE_DESCRIPTION_SUMMARY@

License:        @PROJECT_LICENSE@
URL:            @PROJECT_HOMEPAGE_URL@
Source0:        %{name}-%{version}.tar.bz2

BuildRequires:  cmake
BuildRequires:  gcc-c++
BuildRequires:  desktop-file-utils
BuildRequires:  libappstream-glib
BuildRequires:  cmake(Qt6Core)
BuildRequires:  cmake(Qt6Gui)
BuildRequires:  cmake(Qt6Widgets)
BuildRequires:  cmake(Qt6SerialPort)
BuildRequires:  cmake(Qt6PrintSupport)
BuildRequires:  cmake(Qt6Network)
BuildRequires:  cmake(Qt6Charts)
BuildRequires:  cmake(Qt6Svg)
BuildRequires:  cmake(Qt6Bluetooth)
BuildRequires:  cmake(Qt6Test)
BuildRequires:  cmake(Qt6LinguistTools)
BuildRequires:  pkgconfig(hidapi-hidraw)
Requires:       hicolor-icon-theme
Suggests:       sigrok-cli
# the libraries (Qt modules, hidapi) are found by rpm's automatic dependencies

%description
@CPACK_DEBIAN_PACKAGE_DESCRIPTION@

%prep
%autosetup

%build
%cmake -DBUILD_TESTING=ON
%cmake_build

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/qtdmm.desktop
appstream-util validate-relax --nonet %{buildroot}%{_metainfodir}/io.github.qtdmm.qtdmm.metainfo.xml
QT_QPA_PLATFORM=offscreen %ctest

%install
%cmake_install

%files
%license LICENSE
%doc AUTHORS README.md CHANGELOG
%{_bindir}/qtdmm
%{_datadir}/applications/qtdmm.desktop
%{_datadir}/icons/hicolor/*/apps/qtdmm.png
%{_mandir}/man1/qtdmm.1*
%{_metainfodir}/io.github.qtdmm.qtdmm.metainfo.xml

%changelog
@RPM_CHANGELOG@
